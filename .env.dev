# ===========================================
# OmniDigest 开发环境配置模板
#
# 使用方法:
#   cp .env.dev .env
#   编辑 .env 填入 LLM_API_KEY
#
# 注意:
#   - DB_HOST / REDIS_HOST 在 docker compose 中
#     会被覆盖为容器名 (omnidigest_postgres 等)
#   - 裸机运行 backend 时，改为 localhost
# ===========================================

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=frank
DB_PASSWORD=password
DB_NAME=omnidigest

# ---- Redis ----
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Dgraph ----
DGRAPH_ALPHA_URL=localhost:9080

# ---- LLM 配置 (必填) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ---- 通知机器人 (可选) ----
# 开发环境可以不配置，或填入测试用 Token
# TG_ROBOTS=[{"bot_token":"...","chat_id":"..."}]
# DING_ROBOTS=[{"token":"...","secret":"..."}]

# ---- 开发环境开关 ----
DISABLE_SCHEDULER=true
KG_ENABLED=false
RAGFLOW_ENABLED=false
ENABLE_TWITTER_ALERTS=false
ENABLE_ASTOCK_ANALYSIS=false

# ---- 应用环境 ----
OMNIDIGEST_ENV=dev
TZ=Asia/Shanghai
