# ==========================
# OmniDigest Production Environment Configuration
# 生产环境配置模板
# ==========================
# 复制此文件为 .env.prod 并填写实际值
# DO NOT commit .env.prod to version control!

# ==========================
# Environment
# ==========================
OMNIDIGEST_ENV=production

# ==========================
# Database Configuration (PostgreSQL)
# ==========================
DB_HOST=192.168.3.96
DB_PORT=5432
DB_USER=frank
DB_PASSWORD=  # TODO: Set your production password
DB_NAME=omnidigest

# ==========================
# Redis Configuration
# ==========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# ==========================
# RAGFlow Configuration
# ==========================
RAGFLOW_ENABLED=False
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=

# ==========================
# External LLM Configuration
# ==========================
# LLM config is primarily read from database (llm_providers table)
# .env config is fallback/default only
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL_NAME=

# ==========================
# Notifications
# ==========================
# Telegram Robots - JSON array format
TG_ROBOTS=[]

# DingTalk Robots - JSON array format
DING_ROBOTS=[]

# ==========================
# Scheduler & Jobs
# ==========================
FETCH_INTERVAL_HOURS=1
SUMMARY_HOUR=0,12
SUMMARY_MINUTE=0

# ==========================
# Breaking News
# ==========================
ENABLE_BREAKING_NEWS=True
BREAKING_RAG_ENABLED=False
BREAKING_IMPACT_THRESHOLD=80
BREAKING_PUSH_DINGTALK=True
BREAKING_PUSH_TELEGRAM=True

# ==========================
# Twitter
# ==========================
ENABLE_TWITTER_ALERTS=True
TWITTER_PUSH_DINGTALK=True
TWITTER_PUSH_TELEGRAM=True
TWITTER_IMPACT_THRESHOLD=80

# ==========================
# Knowledge Graph
# ==========================
KG_ENABLED=False
DGRAPH_ALPHA_URL=dgraph:9080

# ==========================
# A-Share Market Analysis
# ==========================
ENABLE_ASTOCK_ANALYSIS=True
ASTOCK_PUSH_TELEGRAM=True
ASTOCK_PUSH_DINGTALK=True

# ==========================
# Security
# ==========================
# Disable scheduler in production if running via cron
# DISABLE_SCHEDULER=false

# ==========================
# Logging
# ==========================
# LOG_LEVEL=INFO
